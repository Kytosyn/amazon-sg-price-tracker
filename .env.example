# Environment variables for DiskPrices Singapore

# Backend
DATABASE_URL=sqlite:///./prices.db
AMAZON_SG_BASE_URL=https://www.amazon.sg
DISCORD_WEBHOOK_URL=

# Frontend
VITE_API_URL=http://localhost:8000

# Amazon.sg Associates tracking ID (outbound click monetization on disk.kytosyn.com)
# Get it after joining https://affiliate-program.amazon.sg/ — looks like yourstore-22
# Set the same var in Vercel env for production.
# VITE_AMAZON_ASSOCIATE_TAG=

# Amazon.sg scrape proxies
# (optional locally; required on GitHub Actions for Amazon ZenRows path)
# SCRAPERAPI_KEY=
# ZENROWS_API_KEY=

# SEA soft-fail for Shopee/Lazada (default 1 in Actions first week; set 0 to harden)
# SEA_SOFT_FAIL=1

# --- Shopee.sg provider (Apify preferred, ZenRows optional fallback) ---
# Actor: lergassy/shopee-scraper (API id lergassy~shopee-scraper)
# Spike (2026-09-24 run eYXIMez1kh3nCa6gd): ~$0.01/item; price field = SGD cents ÷100
# APIFY_TOKEN=                    # required for Apify path (add GitHub Actions secret)
# SHOPEE_PROVIDER=auto            # auto | apify | zenrows
#                                 # auto: Apify if APIFY_TOKEN else ZenRows if ZENROWS_API_KEY
# APIFY_SHOPEE_MAX_ITEMS=100      # hard cap per Actor run (spend guard; max 200)
#                                 # Uses full SEA_QUERIES; Actor distributes under this cap.
#                                 # Cron is */30 — keep this low or rely on pause vars.

# BuyWhere (parked/broken — optional skip)
# https://buywhere.ai/quickstart
# BUYWHERE_API_KEY=

# Shopee Affiliate Open API (SG) — parked/dead end; prefer shopee_scraper.py
# https://affiliate.shopee.sg/
# SHOPEE_AFFILIATE_APP_ID=
# SHOPEE_AFFILIATE_SECRET=

# Lazada Affiliate Open Platform — parked stub; prefer lazada_scraper.py
# https://www.lazada.sg/lazada-affiliate-program
# LAZADA_AFFILIATE_APP_KEY=
# LAZADA_AFFILIATE_APP_SECRET=
# LAZADA_AFFILIATE_ACCESS_TOKEN=

# For production deployment:
# Railway/Render backend URL
# VITE_API_URL=https://your-backend.railway.app
