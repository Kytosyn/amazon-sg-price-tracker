# Environment variables for DiskPrices Singapore

# Backend
DATABASE_URL=sqlite:///./prices.db
AMAZON_SG_BASE_URL=https://www.amazon.sg
DISCORD_WEBHOOK_URL=

# Frontend
VITE_API_URL=http://localhost:8000

# Amazon.sg scrape proxies (optional locally; recommended on GitHub Actions)
# SCRAPERAPI_KEY=
# ZENROWS_API_KEY=

# Shopee Affiliate Open API (SG) — https://affiliate.shopee.sg/
# SHOPEE_AFFILIATE_APP_ID=
# SHOPEE_AFFILIATE_SECRET=

# Lazada Affiliate Open Platform — https://www.lazada.sg/lazada-affiliate-program
# (product-search stub until endpoint confirmed after approval)
# LAZADA_AFFILIATE_APP_KEY=
# LAZADA_AFFILIATE_APP_SECRET=
# LAZADA_AFFILIATE_ACCESS_TOKEN=

# For production deployment:
# Railway/Render backend URL
# VITE_API_URL=https://your-backend.railway.app
