# Environment variables for DiskPrices Singapore

# Backend
DATABASE_URL=sqlite:///./prices.db
AMAZON_SG_BASE_URL=https://www.amazon.sg
DISCORD_WEBHOOK_URL=

# Frontend
VITE_API_URL=http://localhost:8000

# Amazon.sg + Shopee.sg + Lazada.sg scrape proxies
# (optional locally; required on GitHub Actions for Amazon + SEA ZenRows path)
# SCRAPERAPI_KEY=
# ZENROWS_API_KEY=
# SEA soft-fail for Shopee/Lazada (default 1 in Actions first week; set 0 to harden)
# SEA_SOFT_FAIL=1


# BuyWhere (parked/broken — optional skip)
# https://buywhere.ai/quickstart
# BUYWHERE_API_KEY=

# Shopee Affiliate Open API (SG) — parked/dead end; prefer shopee_scraper.py
# https://affiliate.shopee.sg/
# SHOPEE_AFFILIATE_APP_ID=
# SHOPEE_AFFILIATE_SECRET=

# Lazada Affiliate Open Platform — parked stub; prefer lazada_scraper.py
# https://www.lazada.sg/lazada-affiliate-program
# LAZADA_AFFILIATE_APP_KEY=
# LAZADA_AFFILIATE_APP_SECRET=
# LAZADA_AFFILIATE_ACCESS_TOKEN=

# For production deployment:
# Railway/Render backend URL
# VITE_API_URL=https://your-backend.railway.app
